{
  "manifest_version": 3,
  "name": "Radio Stream",
  "version": "0.1.1",
  "description": "Play French radio live audio streams from the extension.",
  "permissions": [],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "host_permissions": [
    "https://streaming.radio.rtl.fr/*",
    "https://*.rtl.fr/*",
    "https://stream.europe1.fr/*",
    "https://*.lmn.fm/*",
    "https://direct.franceinter.fr/*",
    "https://direct.franceinfo.fr/*",
    "https://icecast.radiofrance.fr/*"
  ],
  "action": {
    "default_title": "Radio Stream",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "radio-stream@micaux.com"
    }
  }
}
