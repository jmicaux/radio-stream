{
  "manifest_version": 3,
  "name": "Radio Stream",
  "version": "0.3.2",
  "description": "Play French radio live audio streams from the extension.",
  "permissions": [
    "storage",
    "power"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "host_permissions": [
    "https://*.rtl.fr/*",
    "https://*.rtl2.fr/*",
    "https://*.funradio.fr/*",
    "https://stream.europe1.fr/*",
    "https://*.lmn.fm/*",
    "http://*.lmn.fm/*",
    "https://*.rfm.fr/*",
    "http://chai5she.cdn.dvmr.fr/*",
    "https://chai5she.cdn.dvmr.fr/*",
    "https://audio.bfmtv.com/*",
    "http://bfmbusiness.bfmtv.com/*",
    "https://streaming.nrjaudio.fm/*",
    "https://icecast.skyrock.net/*",
    "http://icecast.skyrock.net/*",
    "https://direct.franceinter.fr/*",
    "https://direct.franceinfo.fr/*",
    "https://icecast.radiofrance.fr/*",
    "https://*.ice.infomaniak.ch/*",
    "http://*.ice.infomaniak.ch/*",
    "https://ice.creacast.com/*",
    "https://radiofg.impek.com/*",
    "http://stream.chantefrance.com/*",
    "https://stream.rcs.revma.com/*"
  ],
  "action": {
    "default_title": "Radio Stream",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "sidebar_action": {
    "default_title": "Radio Stream",
    "default_panel": "sidebar.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "radio-stream@jmicaux.github.io",
      "update_url": "https://raw.githubusercontent.com/jmicaux/radio-stream/main/releases/v0.3.2/firefox/updates.json"
    }
  }
}
